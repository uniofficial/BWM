# Required. Backend Origin only; do not append /api or a trailing path.
VITE_API_BASE_URL=https://api.example.invalid

# Optional. Defaults from the Vite mode when omitted.
VITE_APP_ENV=production

# Optional. Inject these at build time to identify the deployed frontend bundle.
VITE_APP_VERSION=0.0.0
VITE_COMMIT_SHA=local
